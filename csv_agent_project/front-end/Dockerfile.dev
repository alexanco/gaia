# syntax=docker/dockerfile:1
FROM node:23-alpine

WORKDIR /app

# Otimização para Node 23
ENV NODE_OPTIONS="--max-old-space-size=4096"

# Copiar package files
COPY package.json package-lock.json* ./

# Instalar dependências
RUN npm ci

# Copiar código fonte
COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev"]